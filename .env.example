# Base de données PostgreSQL (Neon : copier les deux URL depuis le tableau de bord)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"   # URL "pooled"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"     # URL directe (migrations)

# Secret pour signer les sessions : au moins 32 caractères aléatoires
# (générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=""

# Nom affiché et URL publique (facultatif sur Vercel : détectée automatiquement)
NEXT_PUBLIC_APP_NAME="Ngaoundéré Livraison"
NEXT_PUBLIC_APP_URL=""

# Compte administrateur créé par `npm run seed`
ADMIN_PHONE="6XXXXXXXX"
ADMIN_PASSWORD=""
SEED_DEMO="0"
